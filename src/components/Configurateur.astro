---
import BasketProfil from './BasketProfil.astro';
import BasketDessus from './BasketDessus.astro';

interface Props {
  configurationInitiale?: Record<string, string>;
  gradientsInitiale?: Record<string, string>;
}

const { configurationInitiale, gradientsInitiale = {} } = Astro.props;

const configuration_par_defaut = {
    semelle: "#ffffff",
    empeigne: "#ffffff",
    pointe: "#ffffff",
    oeillet: "#ffffff",
    bande: "#ffffff",
    languette: "#ffffff",
    lacet: "#ffffff",
    trimestre: "#ffffff"
};

const configuration_actuelle = configurationInitiale ?? configuration_par_defaut;
---

<div
  class="configurateur flex flex-col items-center gap-6 p-4"
  data-configuration-defaut={JSON.stringify(configuration_par_defaut)}
  data-gradients={JSON.stringify(gradientsInitiale)}
>
  <div class="flex flex-wrap justify-center gap-4">
    <BasketProfil {...configuration_actuelle} />
    <BasketDessus {...configuration_actuelle} />
  </div>

  <div class="chat-ia flex w-full max-w-md flex-col items-center gap-2 py-2">
    <div class="chat-historique flex max-h-60 w-full flex-col gap-2 overflow-y-auto"></div>
    <textarea
      class="chat-message textarea textarea-bordered w-full"
      placeholder="Ex : une semelle noire et des lacets rouge vif"
    ></textarea>
    <div class="flex w-full gap-2">
      <button
        type="button"
        class="chat-button flex-1 rounded bg-primary px-4 py-2 font-semibold text-white transition hover:bg-secondary"
      >
        Demander à l'IA
      </button>
      <button
        type="button"
        class="chat-nouvelle rounded border border-base-content/30 bg-base-100 px-3 py-2 text-sm font-medium hover:bg-base-200"
      >
        Nouvelle conversation
      </button>
    </div>
  </div>

  <div class="flex w-full max-w-md flex-col gap-3 rounded-lg border border-base-content/20 p-4">
    <h2 class="text-lg font-semibold">Partager cette chaussure</h2>
    <div class="flex w-full gap-2">
      <input
        type="text"
        class="code-chaussure input input-bordered min-w-0 flex-1 font-mono text-sm"
        readonly
        aria-label="Code de la chaussure actuelle"
        placeholder="Le code apparaîtra ici"
      />
      <button type="button" class="copier-code btn btn-primary">Copier le code</button>
    </div>
    <div class="flex w-full gap-2">
      <input
        type="text"
        class="importer-code input input-bordered min-w-0 flex-1 font-mono text-sm"
        placeholder="Coller un code de chaussure"
        aria-label="Code de la chaussure à importer"
      />
      <button type="button" class="importer-chaussure btn btn-outline">Importer</button>
    </div>
    <p class="code-message min-h-5 text-sm" role="status" aria-live="polite"></p>
  </div>

  <div class="flex w-full max-w-md flex-col gap-3 rounded-lg border border-base-content/20 p-4">
    <h2 class="text-lg font-semibold">Ajouter un gradient</h2>
    <div class="flex flex-wrap items-end gap-2">
      <label class="flex min-w-36 flex-1 flex-col gap-1 text-sm font-medium">
        Partie
        <select class="gradient-partie select select-bordered w-full">
          {Object.keys(configuration_actuelle).map((partie) => (
            <option value={partie}>{partie}</option>
          ))}
        </select>
      </label>
      <label class="flex flex-col gap-1 text-sm font-medium">
        Seconde couleur
        <input type="color" class="gradient-couleur h-10 w-16 cursor-pointer" value="#000000" />
      </label>
      <button type="button" class="appliquer-gradient btn btn-primary">Appliquer</button>
      <button type="button" class="supprimer-gradient btn btn-outline">Supprimer</button>
    </div>
    <p class="gradient-message min-h-5 text-sm" role="status" aria-live="polite"></p>
  </div>

  <form method="POST" class="flex flex-col items-center gap-4">
    <input type="hidden" name="gradients" class="gradients-formulaire" value={JSON.stringify(gradientsInitiale)} />
    <input
      type="text"
      name="description"
      placeholder="Nom de la basket"
      class="input input-bordered w-full max-w-xs"
    />
    <input
      type="text"
      name="tags"
      placeholder="Tags séparés par des virgules : sport, rouge"
      class="input input-bordered w-full max-w-xs"
    />
    <div class="flex flex-wrap items-center justify-center gap-4 py-2">
      {Object.entries(configuration_actuelle).map(([partie, couleur]) => (
        <div class="flex flex-col items-center">
          <label for={partie} class="text-sm font-medium capitalize">{partie}</label>
          <input type="color" id={partie} name={partie} value={couleur} class="cursor-pointer" />
        </div>
      ))}
    </div>

    <div class="flex gap-4">
      <button 
        type="submit" 
        class="border-2 border-green-600 bg-green-600 text-white rounded-lg px-4 py-2 font-semibold hover:bg-green-700 transition-colors cursor-pointer"
      >
        Enregistrer la configuration
      </button>

      <button 
        type="button" 
        class="reinitialiser border-2 border-black rounded-lg px-4 py-2 font-semibold hover:bg-black hover:text-white transition-colors cursor-pointer"
      >
        Réinitialiser les couleurs
      </button>
    </div>
  </form>
</div>

<script>
  document.querySelectorAll<HTMLElement>(".configurateur").forEach((configurateur) => {
    const configurationDefaut: Record<string, string> = JSON.parse(configurateur.dataset.configurationDefaut ?? "{}");
    const gradientsInitiaux: Record<string, string> = JSON.parse(configurateur.dataset.gradients ?? "{}");
    const inputs = configurateur.querySelectorAll<HTMLInputElement>('input[type="color"]');
    const history: { role: "user" | "assistant"; content: string }[] = [];
    const chatHistorique = configurateur.querySelector<HTMLDivElement>(".chat-historique");
    const chatButton = configurateur.querySelector<HTMLButtonElement>(".chat-button");
    const chatMessage = configurateur.querySelector<HTMLTextAreaElement>(".chat-message");
    const chatNouvelle = configurateur.querySelector<HTMLButtonElement>(".chat-nouvelle");
    const codeChaussure = configurateur.querySelector<HTMLInputElement>(".code-chaussure");
    const importerCode = configurateur.querySelector<HTMLInputElement>(".importer-code");
    const copierCode = configurateur.querySelector<HTMLButtonElement>(".copier-code");
    const importerChaussure = configurateur.querySelector<HTMLButtonElement>(".importer-chaussure");
    const codeMessage = configurateur.querySelector<HTMLParagraphElement>(".code-message");
    const gradientPartie = configurateur.querySelector<HTMLSelectElement>(".gradient-partie");
    const gradientCouleur = configurateur.querySelector<HTMLInputElement>(".gradient-couleur");
    const appliquerGradient = configurateur.querySelector<HTMLButtonElement>(".appliquer-gradient");
    const supprimerGradient = configurateur.querySelector<HTMLButtonElement>(".supprimer-gradient");
    const gradientMessage = configurateur.querySelector<HTMLParagraphElement>(".gradient-message");
    const gradientsFormulaire = configurateur.querySelector<HTMLInputElement>(".gradients-formulaire");
    const parties = Object.keys(configurationDefaut);
    const gradients: Record<string, string> = { ...gradientsInitiaux };

    const colorier = (partie: string, couleur: string) => {
      const gradientCouleurSecondaire = gradients[partie];
      configurateur.querySelectorAll<SVGElement>(`svg .${partie}`).forEach((element) => {
        if (!gradientCouleurSecondaire) {
          element.setAttribute("fill", couleur);
          return;
        }

        const svg = element.closest("svg");
        const gradient = svg?.querySelector<SVGLinearGradientElement>(`linearGradient[data-partie="${partie}"]`);
        gradient?.querySelector("stop")?.setAttribute("stop-color", couleur);
      });
    };

    const definirGradient = (partie: string, couleurSecondaire: string) => {
      gradients[partie] = couleurSecondaire;

      configurateur.querySelectorAll<SVGSVGElement>("svg").forEach((svg, index) => {
        let defs = svg.querySelector("defs");
        if (!defs) {
          defs = document.createElementNS("http://www.w3.org/2000/svg", "defs");
          svg.prepend(defs);
        }

        const gradientId = `gradient-${partie}-${index}`;
        let gradient = defs.querySelector<SVGLinearGradientElement>(`#${gradientId}`);
        if (!gradient) {
          gradient = document.createElementNS("http://www.w3.org/2000/svg", "linearGradient");
          gradient.id = gradientId;
          gradient.dataset.partie = partie;
          gradient.innerHTML = '<stop offset="0%"></stop><stop offset="100%"></stop>';
          defs.appendChild(gradient);
        }

        gradient.querySelector("stop")?.setAttribute("stop-color", lireConfiguration()[partie]);
        gradient.querySelectorAll("stop")[1]?.setAttribute("stop-color", couleurSecondaire);
        svg.querySelectorAll<SVGElement>(`.${partie}`).forEach((element) => {
          element.setAttribute("fill", `url(#${gradientId})`);
        });
      });
    };

    const retirerGradient = (partie: string) => {
      delete gradients[partie];
      configurateur.querySelectorAll<SVGSVGElement>("svg").forEach((svg) => {
        svg.querySelector(`linearGradient[data-partie="${partie}"]`)?.remove();
      });
      colorier(partie, lireConfiguration()[partie]);
    };

    const lireConfiguration = () => {
      const configuration: Record<string, string> = {};
      inputs.forEach((input) => {
        configuration[input.name] = input.value;
      });
      return configuration;
    };

    const encoderCode = (configuration: Record<string, string>) => {
      const donnees = JSON.stringify({ v: 1, couleurs: configuration, gradients });
      return `BASKET-1-${btoa(donnees)}`;
    };

    const decoderCode = (code: string): { couleurs: Record<string, string>; gradients: Record<string, string> } | null => {
      if (!code.startsWith("BASKET-1-")) return null;

      try {
        const donnees = JSON.parse(atob(code.slice("BASKET-1-".length)));
        const couleurs = donnees?.couleurs;
        if (!couleurs || typeof couleurs !== "object") return null;

        const cles = Object.keys(couleurs).sort();
        if (cles.length !== parties.length || !parties.every((partie) => cles.includes(partie))) return null;
        if (!parties.every((partie) => typeof couleurs[partie] === "string" && /^#[0-9a-fA-F]{6}$/.test(couleurs[partie]))) return null;

        const gradientsImportes = donnees.gradients ?? {};
        if (typeof gradientsImportes !== "object") return null;
        if (!Object.keys(gradientsImportes).every((partie) => parties.includes(partie) && typeof gradientsImportes[partie] === "string" && /^#[0-9a-fA-F]{6}$/.test(gradientsImportes[partie]))) return null;

        return { couleurs, gradients: gradientsImportes };
      } catch {
        return null;
      }
    };

    const afficherCode = () => {
      if (codeChaussure) codeChaussure.value = encoderCode(lireConfiguration());
    };

    const synchroniserGradients = () => {
      if (gradientsFormulaire) gradientsFormulaire.value = JSON.stringify(gradients);
    };

    const afficherMessageCode = (message: string, erreur = false) => {
      if (!codeMessage) return;
      codeMessage.textContent = message;
      codeMessage.className = `code-message min-h-5 text-sm ${erreur ? "text-error" : "text-success"}`;
    };

    const afficherMessage = (role: "user" | "assistant", texte: string) => {
      if (!chatHistorique) return;

      const bulle = document.createElement("div");
      bulle.className = role === "user" ? "chat chat-end" : "chat chat-start";
      bulle.innerHTML = '<div class="chat-bubble"></div>';
      const bubble = bulle.querySelector(".chat-bubble");
      if (bubble) {
        bubble.textContent = texte;
      }

      chatHistorique.appendChild(bulle);
      chatHistorique.scrollTo({ top: chatHistorique.scrollHeight });
    };

    inputs.forEach((input) => {
      input.addEventListener("input", () => {
        colorier(input.name, input.value);
        afficherCode();
      });
    });

    configurateur.querySelector(".reinitialiser")?.addEventListener("click", () => {
      inputs.forEach((input) => {
        input.value = configurationDefaut[input.name];
        colorier(input.name, input.value);
      });
      afficherCode();
    });

    parties.forEach((partie) => {
      if (gradients[partie]) definirGradient(partie, gradients[partie]);
    });
    synchroniserGradients();
    afficherCode();

    appliquerGradient?.addEventListener("click", () => {
      const partie = gradientPartie?.value;
      const couleurSecondaire = gradientCouleur?.value;
      if (!partie || !couleurSecondaire) return;

      definirGradient(partie, couleurSecondaire);
      synchroniserGradients();
      if (gradientMessage) gradientMessage.textContent = `Gradient appliqué sur ${partie}.`;
    });

    supprimerGradient?.addEventListener("click", () => {
      const partie = gradientPartie?.value;
      if (!partie) return;

      retirerGradient(partie);
      synchroniserGradients();
      if (gradientMessage) gradientMessage.textContent = `Gradient supprimé sur ${partie}.`;
    });

    copierCode?.addEventListener("click", async () => {
      afficherCode();
      const code = codeChaussure?.value ?? "";

      try {
        await navigator.clipboard.writeText(code);
        afficherMessageCode("Code copié.");
      } catch {
        codeChaussure?.select();
        afficherMessageCode("Copie automatique impossible : copiez le code sélectionné.", true);
      }
    });

    importerChaussure?.addEventListener("click", () => {
      const chaussure = decoderCode(importerCode?.value.trim() ?? "");
      if (!chaussure) {
        afficherMessageCode("Code invalide ou incompatible.", true);
        return;
      }

      inputs.forEach((input) => {
        input.value = chaussure.couleurs[input.name];
        colorier(input.name, input.value);
      });
      parties.forEach((partie) => {
        retirerGradient(partie);
        if (chaussure.gradients[partie]) {
          definirGradient(partie, chaussure.gradients[partie]);
        }
      });
      synchroniserGradients();
      afficherCode();
      afficherMessageCode("Chaussure importée.");
    });

    chatNouvelle?.addEventListener("click", () => {
      history.length = 0;
      if (chatHistorique) {
        chatHistorique.innerHTML = "";
      }
    });

    chatButton?.addEventListener("click", async () => {
      const message = chatMessage?.value.trim() ?? "";
      if (!message) return;

      chatButton.disabled = true;
      chatButton.textContent = "Réflexion en cours...";

      const configurationActuelle: Record<string, string> = {};
      inputs.forEach((input) => {
        configurationActuelle[input.name] = input.value;
      });

      try {
        const res = await fetch("/api/generateColors", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ message, configuration: configurationActuelle, historique: history }),
        });

        const data = await res.json().catch(() => ({}));
        const couleurs = data.couleurs ?? {};
        const texteAssistant = typeof data.reponse === "string" && data.reponse.trim() ? data.reponse : `Couleurs appliquées : ${Object.keys(couleurs).join(", ") || "Aucune"}`;

        inputs.forEach((input) => {
          if (couleurs[input.name]) {
            input.value = couleurs[input.name];
            colorier(input.name, input.value);
          }
        });
        parties.forEach((partie) => {
          if (gradients[partie]) definirGradient(partie, gradients[partie]);
        });
        synchroniserGradients();
        afficherCode();

        history.push({ role: "user", content: message });
        history.push({ role: "assistant", content: data.reponse ?? JSON.stringify(couleurs) });
        afficherMessage("user", message);
        afficherMessage("assistant", texteAssistant);

        if (chatMessage) {
          chatMessage.value = "";
        }
      } catch (error) {
        console.error("Erreur de requête IA", error);
        afficherMessage("assistant", "Erreur lors de la génération des couleurs.");
      } finally {
        chatButton.disabled = false;
        chatButton.textContent = "Demander à l'IA";
      }
    });
  });
</script>